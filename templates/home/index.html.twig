{% extends 'base.html.twig' %}

{% block title %}{{ 'home.page_title'|trans }}{% endblock %}

{% block body %}
    <header class="site-header" data-controller="nav">
        <div class="site-header__inner">
            <a href="{{ path('app_home') }}" class="brand">Pilence</a>

            <button
                type="button"
                class="nav-toggle"
                data-action="nav#toggle"
                data-nav-target="button"
                aria-label="{{ 'nav.home'|trans }}"
                aria-expanded="false"
            >
                <span></span><span></span><span></span>
            </button>

            <nav class="site-nav" data-nav-target="menu" aria-label="Primary">
                <ul>
                    <li><a href="{{ path('app_home') }}" class="is-active">{{ 'nav.home'|trans }}</a></li>
                    <li><a href="#projects">{{ 'nav.projects'|trans }}</a></li>
                    <li><a href="#services">{{ 'nav.services'|trans }}</a></li>
                    <li><a href="#about">{{ 'nav.about'|trans }}</a></li>
                </ul>
                {{ include('_partials/_language_switcher.html.twig') }}
            </nav>
        </div>
    </header>

    <main>
        <section id="home" class="hero">
            <div class="container">
                <p class="hero__eyebrow">{{ 'hero.eyebrow'|trans }}</p>
                <h1 class="hero__title">{{ 'hero.title'|trans }}</h1>
                <p class="hero__lead">
                    {{ 'hero.lead'|trans }}
                </p>
                <div class="hero__actions">
                    <a href="#projects" class="btn btn--primary">{{ 'hero.view_projects'|trans }}</a>
                    <a href="#about" class="btn btn--ghost">{{ 'hero.about_me'|trans }}</a>
                </div>

                <div class="hero__art" data-controller="svg-animation" aria-hidden="true">
                    <svg viewBox="0 0 240 160" width="240" height="160" role="img">
                        <rect data-svg-animation-target="shape" x="20" y="60" width="60" height="80" rx="8" fill="#4f46e5" />
                        <rect data-svg-animation-target="shape" x="90" y="30" width="60" height="110" rx="8" fill="#7c3aed" />
                        <rect data-svg-animation-target="shape" x="160" y="80" width="60" height="60" rx="8" fill="#ec4899" />
                        <circle data-svg-animation-target="shape" cx="50" cy="30" r="14" fill="#22d3ee" />
                    </svg>
                </div>
            </div>
        </section>

        <section id="projects" class="section">
            <div class="container">
                <h2 class="section__title">{{ 'projects.title'|trans }}</h2>
                <p class="section__lead">{{ 'projects.lead'|trans }}</p>
                <div class="card-grid">
                    <article class="card">
                        <h3 class="card__title">{{ 'projects.card_one.title'|trans }}</h3>
                        <p class="card__text">{{ 'projects.card_one.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'projects.card_two.title'|trans }}</h3>
                        <p class="card__text">{{ 'projects.card_two.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'projects.card_three.title'|trans }}</h3>
                        <p class="card__text">{{ 'projects.card_three.text'|trans }}</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="services" class="section section--muted">
            <div class="container">
                <h2 class="section__title">{{ 'services.title'|trans }}</h2>
                <p class="section__lead">{{ 'services.lead'|trans }}</p>
                <div class="card-grid">
                    <article class="card">
                        <h3 class="card__title">{{ 'services.web.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.web.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'services.consulting.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.consulting.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'services.maintenance.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.maintenance.text'|trans }}</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="about" class="section">
            <div class="container container--narrow">
                <h2 class="section__title">{{ 'about.title'|trans }}</h2>
                <p class="section__text">
                    {{ 'about.text'|trans }}
                </p>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>{{ 'footer.copyright'|trans({'%year%': 'now'|date('Y')}) }}</p>
        </div>
    </footer>
{% endblock %}
