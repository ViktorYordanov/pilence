{% extends 'base.html.twig' %}

{% block title %}{{ 'home.page_title'|trans }}{% endblock %}

{% block body %}
    {{ include('_partials/_header.html.twig', {active: 'home'}) }}

    <main>
        <section id="home" class="hero">
            <div class="container">
                <p class="hero__eyebrow">{{ 'hero.eyebrow'|trans }}</p>
                <h1 class="hero__title">{{ 'hero.title'|trans }}</h1>
                <p class="hero__lead">
                    {{ 'hero.lead'|trans }}
                </p>
                <div class="hero__actions">
                    <a href="#portfolio" class="btn btn--primary">{{ 'hero.view_portfolio'|trans }}</a>
                    <a href="#about" class="btn btn--ghost">{{ 'hero.about_me'|trans }}</a>
                </div>

                <div class="hero__art" data-controller="svg-animation" aria-hidden="true">
                    <svg viewBox="0 0 240 160" width="240" height="160" role="img">
                        <rect data-svg-animation-target="shape" x="20" y="60" width="60" height="80" rx="8" fill="#6813aa" />
                        <rect data-svg-animation-target="shape" x="90" y="30" width="60" height="110" rx="8" fill="#e2450e" />
                        <rect data-svg-animation-target="shape" x="160" y="80" width="60" height="60" rx="8" fill="#87a8f4" />
                        <circle data-svg-animation-target="shape" cx="50" cy="30" r="14" fill="#f7e07f" />
                    </svg>
                </div>
            </div>
        </section>

        <section id="portfolio" class="section">
            <div class="container">
                <h2 class="section__title">{{ 'portfolio.title'|trans }}</h2>
                <p class="section__lead">{{ 'portfolio.lead'|trans }}</p>
                <div class="card-grid">
                    <article class="card">
                        <h3 class="card__title">{{ 'portfolio.card_one.title'|trans }}</h3>
                        <p class="card__text">{{ 'portfolio.card_one.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'portfolio.card_two.title'|trans }}</h3>
                        <p class="card__text">{{ 'portfolio.card_two.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'portfolio.card_three.title'|trans }}</h3>
                        <p class="card__text">{{ 'portfolio.card_three.text'|trans }}</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="services" class="section section--muted">
            <div class="container">
                <h2 class="section__title">{{ 'services.title'|trans }}</h2>
                <p class="section__lead">{{ 'services.lead'|trans }}</p>
                <div class="card-grid">
                    <article class="card">
                        <h3 class="card__title">{{ 'services.web.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.web.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'services.consulting.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.consulting.text'|trans }}</p>
                    </article>
                    <article class="card">
                        <h3 class="card__title">{{ 'services.maintenance.title'|trans }}</h3>
                        <p class="card__text">{{ 'services.maintenance.text'|trans }}</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="about" class="section">
            <div class="container container--narrow">
                <h2 class="section__title">{{ 'about.title'|trans }}</h2>
                <p class="section__text">
                    {{ 'about.text'|trans }}
                </p>
            </div>
        </section>
    </main>

    {{ include('_partials/_footer.html.twig') }}
{% endblock %}
