{# Site header, shared across pages. Pass `active` ('home' | 'projects') to highlight the current nav item. #}
{% set active = active|default('home') %}
<header class="site-header" data-controller="nav">
    <div class="site-header__inner">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Pilence">
            <img src="{{ asset('images/logo.svg') }}" alt="Pilence" class="brand__logo" width="100" height="50">
        </a>

        <button
            type="button"
            class="nav-toggle"
            data-action="nav#toggle"
            data-nav-target="button"
            aria-label="{{ 'nav.toggle'|trans }}"
            aria-expanded="false"
        >
            <span></span><span></span><span></span>
        </button>

        <nav class="site-nav" data-nav-target="menu" aria-label="Primary">
            <ul>
                <li><a href="{{ path('app_home') }}" class="{{ active == 'home' ? 'is-active' : '' }}">{{ 'nav.home'|trans }}</a></li>
                <li class="has-dropdown">
                    <a href="{{ path('app_service', {slug: 'logo-design'}) }}" aria-haspopup="true">{{ 'nav.services'|trans }}</a>
                    {# Service categories mirror the portfolio tag vocabulary (labels: portfolio.tags.*). #}
                    <ul class="dropdown-menu">
                        <li><a href="{{ path('app_service', {slug: 'logo-design'}) }}">{{ ('portfolio.tags.logo_design')|trans }}</a></li>
                        <li><a href="{{ path('app_service', {slug: 'brand-identity'}) }}">{{ ('portfolio.tags.brand_identity')|trans }}</a></li>
                        <li><a href="{{ path('app_service', {slug: 'print-material'}) }}">{{ ('portfolio.tags.print_material')|trans }}</a></li>
                        <li><a href="{{ path('app_service', {slug: 'social-media'}) }}">{{ ('portfolio.tags.social_media')|trans }}</a></li>
                        <li><a href="{{ path('app_service', {slug: 'product-design'}) }}">{{ ('portfolio.tags.product_design')|trans }}</a></li>
                        <li><a href="{{ path('app_service', {slug: 'digital-illustration'}) }}">{{ ('portfolio.tags.digital_illustration')|trans }}</a></li>
                    </ul>
                </li>
                <li><a href="{{ path('app_portfolio') }}" class="{{ active == 'portfolio' ? 'is-active' : '' }}">{{ 'nav.portfolio'|trans }}</a></li>
                <li><a href="{{ path('app_home') }}#about">{{ 'nav.about'|trans }}</a></li>
                <li><a href="{{ path('app_home') }}#contacts" class="contacts_item">{{ 'nav.contacts'|trans }}</a></li>
            </ul>
            {{ include('_partials/_language_switcher.html.twig') }}
        </nav>
    </div>
</header>
