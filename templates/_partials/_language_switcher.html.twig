{# Language toggle — shows only the OTHER language as a short code (EN when on BG, БГ when on EN). #}
{% set short = {bg: 'БГ', en: 'EN'} %}
<div class="lang-switch" aria-label="{{ 'language.label'|trans }}">
    {% for code, label in app_locales %}
        {% if code != app.request.locale %}
            <a class="lang-switch__item" lang="{{ code }}" href="{{ path('app_locale_switch', {_locale: code}) }}" title="{{ label }}">{{ short[code]|default(code|upper) }}</a>
        {% endif %}
    {% endfor %}
</div>
