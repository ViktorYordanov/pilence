{% extends 'base.html.twig' %}

{% block title %}{{ 'portfolio.page_title'|trans }}{% endblock %}

{% block body %}
    {{ include('_partials/_header.html.twig', {active: 'portfolio'}) }}

    <main>
        <section class="section">
            <div class="container">
                <h1 class="section__title">{{ 'portfolio.title'|trans }}</h1>
                <p class="section__lead">{{ 'portfolio.lead'|trans }}</p>

                <div data-controller="portfolio-filter">
                    {# Filter bar: "All" first, then one button per tag #}
                    <div class="portfolio-filter" role="group" aria-label="{{ 'portfolio.filter.aria'|trans }}">
                        <button
                            type="button"
                            class="filter-btn is-active"
                            data-portfolio-filter-target="button"
                            data-tag="all"
                            data-action="portfolio-filter#toggle"
                            aria-pressed="true"
                        >{{ 'portfolio.filter.all'|trans }}</button>
                        {% for tag in tags %}
                            <button
                                type="button"
                                class="filter-btn"
                                data-portfolio-filter-target="button"
                                data-tag="{{ tag }}"
                                data-action="portfolio-filter#toggle"
                                aria-pressed="false"
                            >{{ ('portfolio.tags.' ~ tag)|trans }}</button>
                        {% endfor %}
                    </div>

                    <div class="portfolio-grid" data-portfolio-filter-target="grid">
                        {% for project in projects %}
                            {% set titleField = 'title' ~ app.request.locale|capitalize %}
                            <a
                                href="{{ path('app_project', {id: project.id}) }}"
                                class="portfolio-card"
                                data-portfolio-filter-target="card"
                                data-tags="{% for projectTag in project.projectTags %}{{ projectTag.tagSlug }} {% endfor %}"
                            >
                                <div class="portfolio-card__media{% if project.coverImage is not empty %}" style="background-image: url('{{ project.coverImage }}'){% endif %}" aria-hidden="true"></div>
                                <div class="portfolio-card__body">
                                    <h2 class="portfolio-card__title">{{ attribute(project, titleField)|default(project.titleBg) }}</h2>
                                    <ul class="portfolio-card__tags">
                                        {% for projectTag in project.projectTags %}
                                            <li class="tag-chip">{{ ('portfolio.tags.' ~ projectTag.tagSlug)|trans }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </a>
                        {% endfor %}
                    </div>

                    <p class="portfolio-empty" data-portfolio-filter-target="empty" hidden>{{ 'portfolio.empty'|trans }}</p>
                </div>
            </div>
        </section>
    </main>

    {{ include('_partials/_footer.html.twig') }}
{% endblock %}
